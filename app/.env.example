# Agar.sol / NomNom Environment Variables
# Copy this file to .env to configure local environment variables

# Optional: Supabase Realtime credentials for cross-network multiplayer
# (If not provided, the game automatically falls back to zero-config local tab-to-tab multiplayer)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
